# ==============================================================================
# FORMULA 1 LAKEHOUSE PIPELINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Execution Environment: 'local' (Free OSS default) or 'azure' (Production Cloud)
PIPELINE_ENV=local

# ------------------------------------------------------------------------------
# LOCAL LAKEHOUSE CONFIGURATION (Simulates ADLS Gen2 Hierarchical Namespace)
# ------------------------------------------------------------------------------
LAKEHOUSE_STORAGE_ROOT=./data
RAW_LAYER_PATH=./data/raw
BRONZE_LAYER_PATH=./data/bronze
SILVER_LAYER_PATH=./data/silver
GOLD_LAYER_PATH=./data/gold
SAMPLE_DATA_PATH=./data/sample

# ------------------------------------------------------------------------------
# LOCAL APACHE SPARK & DELTA LAKE SETTINGS
# ------------------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_APP_NAME=Formula1Lakehouse
SPARK_DRIVER_MEMORY=4g
SPARK_SQL_SHUFFLE_PARTITIONS=4

# ------------------------------------------------------------------------------
# AZURE PRODUCTION CLOUD EQUIVALENTS (Used when PIPELINE_ENV=azure)
# ------------------------------------------------------------------------------
# Microsoft Entra ID (Service Principal)
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=mock-sp-secret-key-vault-reference

# Azure Data Lake Storage Gen2 (ADLS Gen2)
ADLS_STORAGE_ACCOUNT=f1lakehousestorage
ADLS_RAW_CONTAINER=abfss://raw@f1lakehousestorage.dfs.core.windows.net
ADLS_BRONZE_CONTAINER=abfss://bronze@f1lakehousestorage.dfs.core.windows.net
ADLS_SILVER_CONTAINER=abfss://silver@f1lakehousestorage.dfs.core.windows.net
ADLS_GOLD_CONTAINER=abfss://gold@f1lakehousestorage.dfs.core.windows.net

# Azure Databricks & Unity Catalog
DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN=dapi_mock_token_for_ci_cd
UNITY_CATALOG_NAME=formula1_catalog

# ------------------------------------------------------------------------------
# ERGAST F1 API (Optional live data extraction)
# ------------------------------------------------------------------------------
ERGAST_API_BASE_URL=https://ergast.com/api/f1
ERGAST_API_RATE_LIMIT_PER_SEC=4
ERGAST_API_TIMEOUT_SEC=15

# ------------------------------------------------------------------------------
# STREAMLIT DASHBOARD CONFIGURATION
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
